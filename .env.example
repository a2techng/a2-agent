# Copy this file to .env and fill in your secret values. Never put these in frontend JavaScript.
PORT=3000
NODE_ENV=production
# Use a current Gemini API key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: configure deployment only if you own/control the target Netlify site
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
# Optional browser origins, comma-separated. Same-origin is supported automatically.
ALLOWED_ORIGINS=
